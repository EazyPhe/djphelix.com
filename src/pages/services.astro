---
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="DJ Services | DJ Phelix" description="Wedding, private-event, nightlife, and themed-event DJ services from DJ Phelix on Cape Cod.">
  <section class="page-hero page-hero-simple" aria-labelledby="services-heading">
    <div class="site-shell page-hero-inner">
      <div>
        <p class="section-number">Services</p>
        <h1 id="services-heading">The right tone begins with a few good questions.</h1>
      </div>
      <p>DJ Phelix works across weddings, private events, nightlife, and themed events. Every offering starts with the event itself—not a guessed package or a one-size-fits-all playlist.</p>
    </div>
  </section>

  <section class="section service-list-section" aria-label="DJ Phelix service categories">
    <div class="site-shell service-list">
      {site.services.map((service, index) => (
        <article class="service-row">
          <span>0{index + 1}</span>
          <div>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
          </div>
          <a class="text-link" href={service.href}>Learn more<ArrowIcon /></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section contrast-section" aria-labelledby="service-approach-heading">
    <div class="site-shell split-content">
      <div>
        <p class="section-number">Approach</p>
        <h2 id="service-approach-heading">A clear plan, with room for the moment.</h2>
      </div>
      <div>
        <p>Before dates, details, equipment, travel, pricing, or package terms are published, Phelix can shape those facts into an inquiry conversation. This first version keeps those unknowns honest and editable.</p>
        <a class="button button-primary" href="/contact/">{site.primaryAction}<ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
