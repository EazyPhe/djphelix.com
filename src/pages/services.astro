---
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="DJ Services | DJ Phelix"
  description="Wedding, private-party, corporate, karaoke, nightlife, themed-event, and community DJ services from DJ Phelix on Cape Cod."
>
  <section class="page-hero page-hero-simple" aria-labelledby="services-heading">
    <div class="site-shell page-hero-inner">
      <div>
        <p class="section-number">Services</p>
        <h1 id="services-heading">The right tone begins with a few good questions.</h1>
      </div>
      <p>
        DJ Phelix works across weddings, birthdays, private parties, corporate events,
        karaoke, nightlife, themed events, and community gatherings. Every offering starts
        with the event itself—not a guessed package or a one-size-fits-all playlist.
      </p>
    </div>
  </section>

  <section class="section service-list-section" aria-label="DJ Phelix service categories">
    <div class="site-shell service-list">
      {site.serviceOfferings.map((service, index) => (
        <article
          class="service-row"
          id={service.id}
          aria-labelledby={`${service.id}-heading`}
        >
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <p class="service-category">{service.category}</p>
            <h2 id={`${service.id}-heading`}>{service.title}</h2>
            <p>{service.description}</p>
          </div>
          <a class="text-link" href={service.actionHref}>
            {service.actionLabel}<ArrowIcon />
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section contrast-section" aria-labelledby="service-approach-heading">
    <div class="site-shell split-content">
      <div>
        <p class="section-number">Approach</p>
        <h2 id="service-approach-heading">A clear plan, with room for the moment.</h2>
      </div>
      <div>
        <p>
          Start with your date, venue, audience, and the atmosphere you want to create.
          From there, Phelix can discuss availability, pricing, equipment, travel, and
          service details without forcing the event into an unverified package.
        </p>
        <a class="button button-primary" href="/contact/">
          {site.primaryAction}<ArrowIcon />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
