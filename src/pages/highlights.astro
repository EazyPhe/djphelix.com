---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import '../styles/highlights.css';
---

<BaseLayout
  title="Highlights | DJ Phelix"
  description="Watch Bring the Energy, Every Kind of Crowd, and Feel the Room with DJ Phelix. See real crowd moments in widescreen and vertical."
>
  <section class="highlights-intro" aria-labelledby="highlights-heading">
    <div class="site-shell">
      <p class="section-number">DJ Phelix in motion</p>
      <h1 id="highlights-heading">Highlights</h1>
      <p>Music brings the room together. Take a look at the moments that follow.</p>
    </div>
  </section>

  {site.media.highlights.map((highlight) => (
    <section class="highlights-feature" data-highlight={highlight.id} aria-labelledby={`${highlight.id}-heading`}>
      <div class="site-shell">
        <div class="highlights-feature-heading">
          <div>
            <h2 id={`${highlight.id}-heading`}>{highlight.title}</h2>
            <p>{highlight.description}</p>
          </div>
          <p class="highlights-watch-note">Watch in widescreen or vertical. Press play for sound.</p>
        </div>

        <div class="highlight-formats" role="group" aria-label={`${highlight.title} video format`} hidden>
          {highlight.formats.map((format) => (
            <button
              type="button"
              data-highlight-format-choice={format.id}
              aria-pressed="false"
              aria-controls={`${highlight.id}-${format.id}-card`}
            >{format.label}</button>
          ))}
        </div>
        <noscript>
          <p class="highlights-fallback">
            Open a video to watch:
            {highlight.formats.map((format) => (
              <a class="text-link" href={format.src}>{format.label}<span class="highlight-sr-only">: {highlight.title}</span></a>
            ))}
          </p>
        </noscript>

        <div class="highlights-player">
          {highlight.formats.map((format) => {
            const videoId = `${highlight.id}-${format.id}`;
            return (
              <article
                id={`${videoId}-card`}
                data-highlight-format={format.id}
                class:list={['highlight-card', `highlight-card-${format.id}`]}
                aria-labelledby={`${videoId}-heading`}
              >
                <div class="highlight-card-heading">
                  <h3 id={`${videoId}-heading`}>{format.label}</h3>
                  <span>{format.aspect} <span aria-hidden="true">·</span> {highlight.durationSeconds} seconds</span>
                </div>
                <video
                  id={videoId}
                  data-highlight-video
                  data-src={format.src}
                  aria-label={`${highlight.title} — ${format.label.toLowerCase()}`}
                  width={format.width}
                  height={format.height}
                  controls
                  playsinline
                  preload="none"
                  poster={format.poster}
                >
                  <a href={format.src}>Open the {format.label.toLowerCase()} video</a>
                </video>
                <div class="highlight-actions">
                  <button
                    class="button button-primary"
                    type="button"
                    data-highlight-toggle={videoId}
                    data-format-label={format.label.toLowerCase()}
                    aria-controls={videoId}
                    hidden
                  >Play {format.label.toLowerCase()}</button>
                  <a class="text-link" href={format.src}>Open video<span class="highlight-sr-only">: {highlight.title}, {format.label.toLowerCase()}</span></a>
                </div>
                <p class="highlight-status" data-highlight-status={videoId} role="status" aria-live="polite"></p>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<script>
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-highlight-video]'));
  // Match the site's mobile content breakpoint; tablets default to widescreen.
  const mobileQuery = window.matchMedia('(max-width: 760px)');

  document.querySelectorAll<HTMLElement>('[data-highlight]').forEach((highlight) => {
    const cards = Array.from(highlight.querySelectorAll<HTMLElement>('[data-highlight-format]'));
    const choices = Array.from(highlight.querySelectorAll<HTMLButtonElement>('[data-highlight-format-choice]'));
    const formats = highlight.querySelector<HTMLElement>('.highlight-formats');
    const storageKey = `djphelix:highlight-format:${highlight.dataset.highlight}`;
    let manualChoice: string | null = null;

    try {
      const saved = sessionStorage.getItem(storageKey);
      if (cards.some((card) => card.dataset.highlightFormat === saved)) manualChoice = saved;
    } catch {
      // In-memory choices still work when browser storage is unavailable.
    }

    const selectFormat = (format: string) => {
      const selected = cards.find((card) => card.dataset.highlightFormat === format) ?? cards[0];
      if (!selected) return;
      const focusMoves = cards.some((card) => card !== selected && card.contains(document.activeElement));

      // Stop playback and release the outgoing source before exposing the next player.
      cards.forEach((card) => {
        const video = card.querySelector('video');
        if (card !== selected && video) {
          video.pause();
          if (video.hasAttribute('src')) {
            video.removeAttribute('src');
            video.load();
          }
        }
        card.hidden = card !== selected;
      });

      const video = selected.querySelector('video');
      if (video?.dataset.src && !video.hasAttribute('src')) {
        // Assigning src respects preload=none; an explicit load() can trigger a download.
        video.src = video.dataset.src;
      }
      choices.forEach((choice) => {
        const active = choice.dataset.highlightFormatChoice === selected.dataset.highlightFormat;
        choice.setAttribute('aria-pressed', String(active));
        if (active && focusMoves) choice.focus({ preventScroll: true });
      });
      highlight.dataset.formatReady = '';
    };

    const applyPreference = () => selectFormat(manualChoice ?? (mobileQuery.matches ? 'vertical' : 'widescreen'));
    choices.forEach((choice) => {
      choice.addEventListener('click', () => {
        manualChoice = choice.dataset.highlightFormatChoice ?? null;
        if (manualChoice) {
          try { sessionStorage.setItem(storageKey, manualChoice); } catch { /* Keep the in-memory choice. */ }
        }
        applyPreference();
      });
    });
    mobileQuery.addEventListener('change', applyPreference);
    applyPreference();
    if (formats) formats.hidden = false;
  });

  videos.forEach((video) => {
    const card = video.closest<HTMLElement>('[data-highlight-format]');
    const button = document.querySelector<HTMLButtonElement>(`[data-highlight-toggle="${video.id}"]`);
    const status = document.querySelector<HTMLElement>(`[data-highlight-status="${video.id}"]`);
    if (!button || !status) return;

    const label = button.dataset.formatLabel ?? 'video';
    const updateButton = () => {
      button.textContent = `${video.ended ? 'Replay' : video.paused ? 'Play' : 'Pause'} ${label}`;
    };
    button.hidden = false;

    button.addEventListener('click', async () => {
      status.textContent = '';
      if (!video.paused) {
        video.pause();
        return;
      }
      videos.forEach((other) => { if (other !== video) other.pause(); });
      if (video.ended) video.currentTime = 0;
      try {
        await video.play();
      } catch {
        if (!card?.hidden) status.textContent = 'Playback could not start. Try the Open video link.';
      }
    });

    video.addEventListener('play', () => {
      if (card?.hidden) {
        video.pause();
        return;
      }
      videos.forEach((other) => { if (other !== video) other.pause(); });
      status.textContent = '';
      updateButton();
    });
    video.addEventListener('pause', updateButton);
    video.addEventListener('ended', updateButton);
    video.addEventListener('emptied', () => {
      status.textContent = '';
      updateButton();
    });
    video.addEventListener('error', () => {
      if (!card?.hidden) status.textContent = 'This video could not load. Try the Open video link.';
      updateButton();
    });
  });
</script>
