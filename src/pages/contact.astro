---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
import ContactCard from '../components/ContactCard.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { site } from '../data/site';

// Use only the owner-approved contact address. Never store completed tax,
// insurance, banking, signature, or document-access data in this public site.
const inquiryEmail = site.contact.inquiryEmail.trim();

const w9RequestBody = [
  'Hello DJ Phelix,',
  '',
  'Please review my request for a W-9 for vendor setup.',
  '',
  'Requester name: ',
  'Venue / business name: ',
  'Business email: ',
  'Reason for requesting a W-9: ',
  'Event name and date (when applicable): ',
  'Submission deadline: ',
  '',
  'I understand that this request requires manual review and does not grant document access automatically.'
].join('\r\n');

const vendorInquiryBody = [
  'Hello DJ Phelix,',
  '',
  'I need help with vendor onboarding or event administration.',
  '',
  'Requester name: ',
  'Venue / business name: ',
  'Business email: ',
  'Event name and date: ',
  'Requirement: vendor registration / contract / purchase order / invoice / insurance requirement / other',
  'Deadline: ',
  'Portal or submission instructions: ',
  'Notes: ',
  '',
  'I will not include tax IDs, banking details, passwords, or other sensitive information in this email.'
].join('\r\n');

const buildMailto = (subject: string, body: string) =>
  inquiryEmail
    ? `mailto:${encodeURIComponent(inquiryEmail)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
    : undefined;

const w9RequestHref = buildMailto('W-9 request | DJ Phelix', w9RequestBody);
const vendorInquiryHref = buildMailto('Vendor onboarding inquiry | DJ Phelix', vendorInquiryBody);
---

<BaseLayout title="Contact & Booking Inquiry | DJ Phelix" description="Save the DJ Phelix contact card, start a booking inquiry, or request venue and vendor documentation for a Cape Cod event.">
  <section class="page-hero page-hero-simple contact-hero" aria-labelledby="contact-heading">
    <div class="site-shell page-hero-inner">
      <div>
        <p class="section-number">Contact</p>
        <h1 id="contact-heading">Start a booking inquiry.</h1>
        <div class="hero-actions">
          <a class="button button-primary" href="#save-contact">Save contact</a>
          <a class="button button-secondary" href="#vendor-resources">Venue resources</a>
        </div>
      </div>
      <p>Save the contact card, text or email directly, and share the event date, location, and atmosphere you have in mind.</p>
    </div>
  </section>

  <ContactCard />

  <section class="section booking-section" aria-labelledby="booking-form-heading">
    <div class="site-shell booking-layout">
      <div class="booking-intro">
        <p class="section-number">What to share</p>
        <h2 id="booking-form-heading">The details that help make the next conversation useful.</h2>
        <p>Include your event type, date, venue or location, and the atmosphere you want to create. The form below does not send an inquiry until a delivery endpoint is connected, so use the email fallback when needed.</p>
      </div>
      <BookingForm />
    </div>
  </section>

  <section id="vendor-resources" class="section vendor-section" aria-labelledby="vendor-resources-heading">
    <div class="site-shell">
      <div class="vendor-intro">
        <div>
          <p class="section-number">Venue & vendor resources</p>
          <h2 id="vendor-resources-heading">Private documents stay private.</h2>
        </div>
        <div>
          <p>W-9 and organization-specific onboarding requests are reviewed before anything is shared. No completed tax forms, banking information, signed contracts, customer records, or insurance documents are stored here for public download.</p>
          <a class="text-link" href="/client-documents/">Open all client and venue resources <ArrowIcon size={16} /></a>
        </div>
      </div>

      <div class="vendor-grid">
        <article class="vendor-card">
          <p class="section-number">Tax documentation</p>
          <h3>Request a W-9.</h3>
          <p>For legitimate venue, planner, client-accounting, and accounts-payable requests. Include your name, business, business email, reason for the request, event information, and deadline when available.</p>
          <div class="vendor-action">
            {w9RequestHref ? (
              <>
                <a class="button button-primary" href={w9RequestHref} aria-describedby="w9-delivery-note">Request W-9</a>
                <p id="w9-delivery-note" class="vendor-note">Opens a prefilled email. The request requires manual review and does not grant access automatically.</p>
              </>
            ) : (
              <>
                <button class="button button-disabled" type="button" disabled aria-describedby="w9-delivery-note">Request W-9</button>
                <p id="w9-delivery-note" class="vendor-note">Online W-9 requests are not connected yet.</p>
              </>
            )}
          </div>
        </article>

        <article class="vendor-card">
          <p class="section-number">Business administration</p>
          <h3>Vendor onboarding inquiry.</h3>
          <p>Use this for vendor registration, contract routing, purchase orders, invoice requirements, portal instructions, payment administration, or a venue's documented insurance requirement.</p>
          <div class="vendor-action">
            {vendorInquiryHref ? (
              <>
                <a class="button button-secondary" href={vendorInquiryHref} aria-describedby="vendor-inquiry-note">Start vendor inquiry</a>
                <p id="vendor-inquiry-note" class="vendor-note">Opens a prefilled email to the current DJ Phelix inquiry address.</p>
              </>
            ) : (
              <>
                <button class="button button-disabled" type="button" disabled aria-describedby="vendor-inquiry-note">Start vendor inquiry</button>
                <p id="vendor-inquiry-note" class="vendor-note">Online vendor inquiries are not connected yet.</p>
              </>
            )}
          </div>
        </article>
      </div>

      <p class="vendor-privacy">Do not send Social Security numbers, EINs, banking details, passwords, tax documents, voided checks, copies of identification, or payment-card information through these email links.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .vendor-section {
    border-top: 1px solid var(--line);
    scroll-margin-top: 7rem;
  }

  .vendor-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-4);
    align-items: end;
    margin-bottom: var(--space-4);
  }

  .vendor-intro h2 {
    max-width: 12ch;
  }

  .vendor-intro > div:last-child > p {
    max-width: 52rem;
  }

  .vendor-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    align-items: stretch;
  }

  .vendor-card {
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    padding: var(--space-3);
    border: 1px solid var(--line);
    background: var(--canvas-raised);
  }

  .vendor-card h3 {
    margin-bottom: var(--space-1);
  }

  .vendor-card > p:not(.section-number) {
    margin-bottom: 0;
  }

  .vendor-action {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .vendor-note {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }

  .button-disabled,
  .button-disabled:hover {
    border-color: var(--line);
    color: var(--muted);
    background: rgba(255, 247, 252, 0.04);
    cursor: not-allowed;
    opacity: 0.72;
    transform: none;
  }

  .vendor-privacy {
    max-width: 72rem;
    margin: var(--space-3) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }

  @media (max-width: 900px) {
    .vendor-intro,
    .vendor-grid {
      grid-template-columns: 1fr;
    }

    .vendor-card {
      min-height: auto;
    }
  }
</style>
