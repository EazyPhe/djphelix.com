---
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | DJ Phelix" noIndex={true}>
  <section class="page-hero page-hero-simple not-found" aria-labelledby="not-found-heading">
    <div class="site-shell page-hero-inner">
      <div>
        <p class="section-number">404</p>
        <h1 id="not-found-heading">That page is not in the set.</h1>
      </div>
      <p><a class="text-link" href="/">Return home<ArrowIcon /></a></p>
    </div>
  </section>
</BaseLayout>
