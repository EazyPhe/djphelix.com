---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { site } from '../data/site';

const inquiryEmail = site.contact.inquiryEmail.trim();

const buildMailto = (subject: string, body: string) =>
  inquiryEmail
    ? `mailto:${encodeURIComponent(inquiryEmail)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
    : undefined;

const returnFormBody = [
  'Hello DJ Phelix,',
  '',
  'I am returning a completed planning document for review.',
  '',
  'Name: ',
  'Event name or client: ',
  'Event date: ',
  'Venue: ',
  'Document attached: ',
  'Questions or changes that need attention: ',
  '',
  'I saved the completed PDF before attaching it. I have not included tax IDs, banking details, payment-card information, identification, or other sensitive records.'
].join('\r\n');

const w9RequestBody = [
  'Hello DJ Phelix,',
  '',
  'Please review my request for a W-9 for vendor setup.',
  '',
  'Requester name: ',
  'Venue / business name: ',
  'Business email: ',
  'Reason for requesting a W-9: ',
  'Event name and date (when applicable): ',
  'Submission deadline: ',
  '',
  'I understand that this request requires manual review and does not grant document access automatically.'
].join('\r\n');

const vendorInquiryBody = [
  'Hello DJ Phelix,',
  '',
  'I need help with vendor onboarding or event administration.',
  '',
  'Requester name: ',
  'Venue / business name: ',
  'Business email: ',
  'Event name and date: ',
  'Requirement: vendor registration / contract / purchase order / invoice / insurance requirement / other',
  'Deadline: ',
  'Portal or submission instructions: ',
  'Notes: ',
  '',
  'I will not include tax IDs, banking details, passwords, or other sensitive information in this email.'
].join('\r\n');

const returnFormHref = buildMailto('Completed planning form | DJ Phelix', returnFormBody);
const w9RequestHref = buildMailto('W-9 request | DJ Phelix', w9RequestBody);
const vendorInquiryHref = buildMailto('Vendor onboarding inquiry | DJ Phelix', vendorInquiryBody);

const planningDocuments = [
  {
    number: '01',
    audience: 'Client + planner',
    eyebrow: 'Primary planning questionnaire',
    title: 'Event, Music & Service Request Form',
    description:
      'The main worksheet for event goals, timeline cues, must-play and do-not-play selections, key songs, MC details, service requests, and venue logistics.',
    href: '/documents/DJ_Phelix_Event_Music_Service_Request_Form.pdf',
    filename: 'DJ_Phelix_Event_Music_Service_Request_Form.pdf',
    pages: '5 pages',
    version: 'Public form',
    revised: 'September 2026',
    includes: [
      'Event profile, audience context, atmosphere, and priorities',
      'Timeline for entrances, formalities, dancing, and closing',
      'Music direction, featured songs, requests, and exclusions',
      'MC notes, service interests, access, power, and weather details'
    ]
  },
  {
    number: '02',
    audience: 'Wedding client + planner',
    eyebrow: 'Wedding detail addendum',
    title: 'Wedding Cue & Pronunciation Addendum',
    description:
      'A fillable three-page addendum for exact names, phonetic pronunciations, ceremony cues, reception formalities, MC guidance, and day-of decision authority.',
    href: '/documents/DJ_Phelix_Wedding_Cue_Pronunciation_Addendum.pdf',
    filename: 'DJ_Phelix_Wedding_Cue_Pronunciation_Addendum.pdf',
    pages: '3 pages',
    version: 'Version 1.0',
    revised: 'September 2026',
    includes: [
      'Couple and wedding-party names with phonetic pronunciations',
      'Ceremony processional, recessional, and media cues',
      'Reception introductions, dances, toasts, traditions, and closing',
      'Announcement limits and authorized day-of decision-makers'
    ]
  },
  {
    number: '03',
    audience: 'Client + planner',
    eyebrow: 'Planning sequence',
    title: 'Event Planning Milestone Checklist',
    description:
      'A fillable two-page checklist organized around relative milestones instead of invented universal deadlines.',
    href: '/documents/DJ_Phelix_Event_Planning_Milestone_Checklist.pdf',
    filename: 'DJ_Phelix_Event_Planning_Milestone_Checklist.pdf',
    pages: '2 pages',
    version: 'Version 1.0',
    revised: 'September 2026',
    includes: [
      'Immediately-after-booking decisions and contacts',
      'Early planning for atmosphere, music, services, and venue needs',
      'Final-review and final-week confirmation steps',
      'Event-day communication and change-control reminders'
    ]
  }
] as const;

const agreementDocument = {
  number: '04',
  audience: 'Prospective client',
  eyebrow: 'Public sample for review',
  title: 'Sample Event Entertainment Service Agreement',
  description:
    'A public four-page sample showing the categories normally addressed in an event agreement, including scope, schedule, services, fees, cancellation choices, venue responsibilities, operating terms, attachments, and signatures.',
  href: '/documents/DJ_Phelix_Event_Service_Agreement_Template.pdf',
  filename: 'DJ_Phelix_Event_Service_Agreement_Template.pdf',
  pages: '4 pages',
  version: 'Sample only',
  revised: 'September 2026',
  includes: [
    'Illustrative event scope, schedule, access, and service fields',
    'Illustrative fees, retainer, balance, overtime, and cancellation fields',
    'Client and venue responsibilities and operating conditions',
    'Signature areas for an individualized final agreement'
  ]
} as const;

const venueDocuments = [
  {
    number: '05',
    audience: 'Venue + planner',
    eyebrow: 'Venue coordination form',
    title: 'Venue Technical & Logistics Advance',
    description:
      'A fillable four-page venue-completed worksheet for access, parking, load-in, setup footprint, electrical service, sound limits, weather protection, restrictions, accessibility, and onboarding requirements.',
    href: '/documents/DJ_Phelix_Venue_Technical_Logistics_Advance.pdf',
    filename: 'DJ_Phelix_Venue_Technical_Logistics_Advance.pdf',
    pages: '4 pages',
    version: 'Version 1.0',
    revised: 'September 2026',
    includes: [
      'Venue and facilities contacts plus access windows',
      'Load-in route, parking, performance area, and electrical service',
      'Sound, curfew, weather, safety, and venue restrictions',
      'Vendor registration, document requirements, and open questions'
    ]
  },
  {
    number: '06',
    audience: 'Planner + venue',
    eyebrow: 'Shareable business overview',
    title: 'DJ Phelix One-Sheet',
    description:
      'A one-page, brand-aligned overview that can be forwarded internally to planners, venue teams, and prospective clients.',
    href: '/documents/DJ_Phelix_One_Sheet.pdf',
    filename: 'DJ_Phelix_One_Sheet.pdf',
    pages: '1 page',
    version: 'Version 1.0',
    revised: 'September 2026',
    includes: [
      'Confirmed service categories and service area',
      'Direct phone, email, website, and contact-card information',
      'QR access to contact and resource options',
      'Clear distinction between public resources and private records'
    ]
  }
] as const;

const faqs = [
  {
    question: 'Which form should I complete first?',
    answer:
      'Start with the Event, Music & Service Request Form. Use the wedding addendum when exact wedding-party names, pronunciations, ceremony cues, or reception formalities need more room. Ask the venue or planner to complete the venue advance when they control the building details.'
  },
  {
    question: 'Does the sample agreement reserve my date?',
    answer:
      'No. The public agreement is a review sample only. A date is not reserved by downloading or completing it. The final individualized agreement and the required booking steps must be intentionally completed.'
  },
  {
    question: 'Can these PDFs be completed on a phone?',
    answer:
      'Some mobile PDF apps support fillable fields, but behavior varies. For the most reliable result, download the PDF, save a local copy, complete it in a full PDF application, save it again, and verify that the entries remain visible before returning it.'
  },
  {
    question: 'How do I return a completed form?',
    answer:
      'Use the Return Completed Form section below. It opens a prepared email. Attach the saved PDF in your email app, add any open questions, and send it for review. The website itself does not upload the file.'
  },
  {
    question: 'Who should complete the venue advance?',
    answer:
      'A venue manager, facilities contact, coordinator, planner, or another person authorized to answer access, power, sound, weather, restriction, and vendor-onboarding questions.'
  },
  {
    question: 'How does a venue request a W-9?',
    answer:
      'Use the Request W-9 control in the Private Vendor Documents section. The request is reviewed manually. The completed tax form is never posted as a public download and access is not automatic.'
  },
  {
    question: 'What should never be placed in these public forms?',
    answer:
      'Do not include Social Security numbers, EINs, banking or ACH details, passwords, copies of identification, tax forms, voided checks, or payment-card information.'
  }
] as const;
---

<BaseLayout
  title="Client & Venue Resources | DJ Phelix"
  description="Download DJ Phelix event-planning, wedding-cue, venue-advance, sample-agreement, checklist, and one-sheet resources; return completed forms; or request private vendor documents."
>
  <section class="page-hero page-hero-simple resources-hero" aria-labelledby="resources-heading">
    <div class="site-shell page-hero-inner">
      <div>
        <p class="section-number">Client & venue resources</p>
        <h1 id="resources-heading">One organized place for the event.</h1>
        <div class="hero-actions">
          <a class="button button-primary" href="#start">Find your resource</a>
          <a class="button button-secondary" href="#return-form">Return a completed form</a>
        </div>
      </div>
      <p>Public planning tools for clients, planners, and venue teams - plus controlled request paths for tax and vendor documents that should never be exposed as public downloads.</p>
    </div>
  </section>

  <section id="start" class="resource-start" aria-labelledby="start-heading">
    <div class="site-shell start-layout">
      <div>
        <p class="section-number">Choose your role</p>
        <h2 id="start-heading">Go directly to the information you own.</h2>
      </div>
      <nav class="role-links" aria-label="Resource shortcuts by role">
        <a href="#planning-resources">
          <span>Client</span>
          <strong>Music, timeline, and event details</strong>
          <ArrowIcon size={16} />
        </a>
        <a href="#planning-resources">
          <span>Planner</span>
          <strong>Cues, milestones, and coordination</strong>
          <ArrowIcon size={16} />
        </a>
        <a href="#venue-resources">
          <span>Venue</span>
          <strong>Access, power, restrictions, and onboarding</strong>
          <ArrowIcon size={16} />
        </a>
      </nav>
    </div>
  </section>

  <section id="planning-resources" class="section resource-section" aria-labelledby="planning-heading">
    <div class="site-shell">
      <div class="section-intro compact-intro resource-intro">
        <div>
          <p class="section-number">Plan the event</p>
          <h2 id="planning-heading">Build the working plan before event day.</h2>
        </div>
        <p>Use the main questionnaire first, then add the wedding and milestone documents only where they improve clarity.</p>
      </div>

      <div class="resource-grid resource-grid-three">
        {planningDocuments.map((document) => (
          <article class="resource-card">
            <div class="resource-card-heading">
              <span class="resource-number" aria-hidden="true">{document.number}</span>
              <div>
                <p class="resource-audience">{document.audience}</p>
                <p class="section-number">{document.eyebrow}</p>
                <h3>{document.title}</h3>
              </div>
            </div>
            <p class="resource-description">{document.description}</p>
            <ul class="resource-includes" aria-label={`${document.title} includes`}>
              {document.includes.map((item) => <li>{item}</li>)}
            </ul>
            <div class="resource-meta" aria-label="Document details">
              <span>Fillable PDF</span>
              <span>{document.pages}</span>
              <span>{document.version}</span>
              <span>Revised {document.revised}</span>
            </div>
            <div class="resource-actions">
              <a class="button button-primary" href={document.href} download={document.filename}>
                Download PDF
                <ArrowIcon size={16} />
              </a>
              <a class="button button-secondary" href={document.href} target="_blank" rel="noreferrer">Preview PDF</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section sample-section" aria-labelledby="agreement-heading">
    <div class="site-shell sample-layout">
      <div class="sample-copy">
        <p class="section-number">Review booking documents</p>
        <h2 id="agreement-heading">Know the categories before the final agreement arrives.</h2>
        <p>The public file is a sample for review. It is not an offer, an executed agreement, or proof that a date is reserved.</p>
        <div class="sample-warning" role="note">
          <strong>Sample only.</strong>
          <span>Final event terms must be individualized, reviewed, intentionally accepted, and signed by both parties.</span>
        </div>
      </div>

      <article class="resource-card resource-card-featured">
        <div class="resource-card-heading">
          <span class="resource-number" aria-hidden="true">{agreementDocument.number}</span>
          <div>
            <p class="resource-audience">{agreementDocument.audience}</p>
            <p class="section-number">{agreementDocument.eyebrow}</p>
            <h3>{agreementDocument.title}</h3>
          </div>
        </div>
        <p class="resource-description">{agreementDocument.description}</p>
        <ul class="resource-includes" aria-label={`${agreementDocument.title} includes`}>
          {agreementDocument.includes.map((item) => <li>{item}</li>)}
        </ul>
        <div class="resource-meta" aria-label="Document details">
          <span>Fillable PDF</span>
          <span>{agreementDocument.pages}</span>
          <span>{agreementDocument.version}</span>
          <span>Revised {agreementDocument.revised}</span>
        </div>
        <div class="resource-actions">
          <a class="button button-primary" href={agreementDocument.href} download={agreementDocument.filename}>
            Download sample
            <ArrowIcon size={16} />
          </a>
          <a class="button button-secondary" href={agreementDocument.href} target="_blank" rel="noreferrer">Preview sample</a>
        </div>
      </article>
    </div>
  </section>

  <section id="venue-resources" class="section resource-section venue-section" aria-labelledby="venue-heading">
    <div class="site-shell">
      <div class="section-intro compact-intro resource-intro">
        <div>
          <p class="section-number">Coordinate the venue</p>
          <h2 id="venue-heading">Get building details from the people who know them.</h2>
        </div>
        <p>The venue advance reduces client guesswork. The one-sheet gives planners and venue teams a clean summary they can forward internally.</p>
      </div>

      <div class="resource-grid resource-grid-two">
        {venueDocuments.map((document) => (
          <article class="resource-card">
            <div class="resource-card-heading">
              <span class="resource-number" aria-hidden="true">{document.number}</span>
              <div>
                <p class="resource-audience">{document.audience}</p>
                <p class="section-number">{document.eyebrow}</p>
                <h3>{document.title}</h3>
              </div>
            </div>
            <p class="resource-description">{document.description}</p>
            <ul class="resource-includes" aria-label={`${document.title} includes`}>
              {document.includes.map((item) => <li>{item}</li>)}
            </ul>
            <div class="resource-meta" aria-label="Document details">
              <span>{document.number === '06' ? 'Public PDF' : 'Fillable PDF'}</span>
              <span>{document.pages}</span>
              <span>{document.version}</span>
              <span>Revised {document.revised}</span>
            </div>
            <div class="resource-actions">
              <a class="button button-primary" href={document.href} download={document.filename}>
                Download PDF
                <ArrowIcon size={16} />
              </a>
              <a class="button button-secondary" href={document.href} target="_blank" rel="noreferrer">Preview PDF</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="return-form" class="section return-section" aria-labelledby="return-heading">
    <div class="site-shell return-panel">
      <div>
        <p class="section-number">Return completed documents</p>
        <h2 id="return-heading">Save, attach, and send for review.</h2>
        <p>The website does not upload files. The control below opens a prepared email; attach the completed PDF in your email app after confirming that your entries were saved.</p>
      </div>
      <div class="return-actions">
        <ol>
          <li><span>01</span>Download and save a local copy.</li>
          <li><span>02</span>Complete the applicable sections and save again.</li>
          <li><span>03</span>Open the prepared email and attach the saved PDF.</li>
          <li><span>04</span>Identify unresolved questions or requested changes.</li>
        </ol>
        {returnFormHref ? (
          <>
            <a class="button button-primary" href={returnFormHref}>Return completed form <ArrowIcon size={16} /></a>
            <p class="action-note">The attachment must be added manually in your email application.</p>
          </>
        ) : (
          <>
            <button class="button button-disabled" type="button" disabled>Return completed form</button>
            <p class="action-note">The document-return email route is not connected yet.</p>
          </>
        )}
      </div>
    </div>
  </section>

  <section id="private-documents" class="section private-section" aria-labelledby="private-heading">
    <div class="site-shell">
      <div class="section-intro compact-intro private-intro">
        <div>
          <p class="section-number">Private vendor documents</p>
          <h2 id="private-heading">Request access. Do not look for a public file.</h2>
        </div>
        <p>Tax, banking, signed-contract, and organization-specific records are shared only when there is a legitimate business purpose and the requester has been reviewed.</p>
      </div>

      <div class="private-grid">
        <article class="private-card">
          <p class="section-number">Tax documentation</p>
          <h3>Request a W-9.</h3>
          <p>For legitimate venue, planner, client-accounting, and accounts-payable requests. The request does not grant automatic access.</p>
          {w9RequestHref ? (
            <a class="button button-primary" href={w9RequestHref}>Request W-9 <ArrowIcon size={16} /></a>
          ) : (
            <button class="button button-disabled" type="button" disabled>Request W-9</button>
          )}
        </article>

        <article class="private-card">
          <p class="section-number">Business administration</p>
          <h3>Vendor onboarding inquiry.</h3>
          <p>Use this for vendor registration, contract routing, purchase orders, invoice requirements, portal instructions, or a venue's documented insurance requirement.</p>
          {vendorInquiryHref ? (
            <a class="button button-secondary" href={vendorInquiryHref}>Start vendor inquiry <ArrowIcon size={16} /></a>
          ) : (
            <button class="button button-disabled" type="button" disabled>Start vendor inquiry</button>
          )}
        </article>

        <aside class="private-policy" aria-label="Private-document policy">
          <p class="section-number">Release policy</p>
          <h3>Manual review remains in control.</h3>
          <ul>
            <li>No completed W-9 is stored in the public website repository.</li>
            <li>No EIN, ACH detail, voided check, signed contract, or customer record is published here.</li>
            <li>Organization-specific documents are delivered through an appropriate private route.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-heading">
    <div class="site-shell faq-layout">
      <div class="faq-intro">
        <p class="section-number">Frequently asked questions</p>
        <h2 id="faq-heading">Use the right document for the right job.</h2>
        <p>These answers describe the current public workflow. Final signed terms and direct written confirmations control when they differ.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section safety-section" aria-labelledby="safety-heading">
    <div class="site-shell safety-panel">
      <div>
        <p class="section-number">Document safety</p>
        <h2 id="safety-heading">Keep sensitive records out of public forms.</h2>
      </div>
      <div>
        <p>Do not place Social Security numbers, EINs, banking details, passwords, copies of identification, tax forms, voided checks, or payment-card information in any public planning PDF.</p>
        <p>Downloading, completing, or returning a public planning document does not reserve a date, amend a signed agreement, add equipment or services, or authorize overtime.</p>
        <a class="text-link" href="/contact/">Need help choosing a resource? Contact DJ Phelix.</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resources-hero,
  .resource-start,
  .resource-section,
  .sample-section,
  .return-section,
  .private-section,
  .faq-section,
  .safety-section {
    border-bottom: 1px solid var(--line);
  }

  #start,
  #planning-resources,
  #venue-resources,
  #return-form,
  #private-documents {
    scroll-margin-top: 7rem;
  }

  .resource-start {
    padding-block: var(--space-4);
    background: var(--canvas-soft);
  }

  .start-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-4);
    align-items: end;
  }

  .start-layout h2 {
    max-width: 11ch;
  }

  .role-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .role-links a {
    display: grid;
    min-width: 0;
    grid-template-columns: 1fr auto;
    gap: 0.55rem 1rem;
    padding: 1.3rem 1rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 160ms ease;
  }

  .role-links a + a {
    border-left: 1px solid var(--line);
  }

  .role-links a:hover {
    background: rgba(255, 53, 209, 0.07);
  }

  .role-links span {
    color: var(--coral-bright);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .role-links strong {
    grid-column: 1 / -1;
    color: var(--paper);
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .role-links svg {
    color: var(--paper);
  }

  .resource-section,
  .sample-section,
  .return-section,
  .private-section,
  .faq-section,
  .safety-section {
    border-top: 0;
  }

  .resource-intro h2,
  .private-intro h2 {
    max-width: 13ch;
  }

  .resource-grid {
    display: grid;
    gap: var(--space-2);
    align-items: stretch;
  }

  .resource-grid-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .resource-grid-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .resource-card {
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    padding: var(--space-3);
    border: 1px solid var(--line);
    background: var(--canvas-raised);
  }

  .resource-card-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .resource-number {
    display: grid;
    width: 2.45rem;
    height: 2.45rem;
    place-items: center;
    border: 1px solid var(--coral);
    color: var(--coral-bright);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .resource-audience {
    margin: 0 0 0.55rem;
    color: var(--brand-yellow);
    font-size: 0.67rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resource-card .section-number {
    margin-bottom: 0.75rem;
  }

  .resource-card h3 {
    margin-bottom: var(--space-1);
  }

  .resource-description {
    margin-bottom: var(--space-2);
  }

  .resource-includes {
    display: grid;
    gap: 0.65rem;
    padding: 0;
    margin: 0 0 var(--space-3);
    list-style: none;
  }

  .resource-includes li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--paper-dim);
    font-size: 0.84rem;
  }

  .resource-includes li::before {
    position: absolute;
    top: 0.75em;
    left: 0;
    width: 0.45rem;
    height: 1px;
    background: var(--coral);
    content: '';
  }

  .resource-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }

  .resource-meta span {
    padding: 0.32rem 0.48rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.61rem;
    font-weight: 700;
