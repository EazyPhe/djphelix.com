---
import { hasBookingEndpoint, hasInquiryEmail, site } from '../data/site';

const endpoint = site.booking.formEndpoint;
const formAction = hasBookingEndpoint ? endpoint : undefined;
const submitLabel = hasBookingEndpoint ? 'Send booking inquiry' : 'Prepare inquiry';
---

<form
  class="booking-form"
  action={formAction}
  method={site.booking.method}
  accept-charset="UTF-8"
  data-booking-form
  data-booking-endpoint={endpoint}
>
  {hasBookingEndpoint && (
    <>
      <input type="hidden" name="_subject" value={site.booking.subject} />
      <input type="hidden" name="_next" value={site.booking.successUrl} />
      <input type="hidden" name="_url" value={site.booking.sourceUrl} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_autoresponse" value={site.booking.autoresponse} />
      <div class="form-honeypot" aria-hidden="true">
        <label for="booking-website">Leave this field empty</label>
        <input id="booking-website" type="text" name="_honey" tabindex="-1" autocomplete="off" />
      </div>
    </>
  )}

  <div class="form-grid">
    <label>
      <span>Name <em aria-hidden="true">*</em></span>
      <input name="name" autocomplete="name" required />
    </label>
    <label>
      <span>Email <em aria-hidden="true">*</em></span>
      <input name="email" type="email" inputmode="email" autocomplete="email" required />
    </label>
    <label>
      <span>Phone <small>(optional)</small></span>
      <input name="phone" type="tel" autocomplete="tel" />
    </label>
    <label>
      <span>Event type <em aria-hidden="true">*</em></span>
      <select name="eventType" required>
        <option value="">Choose an event type</option>
        {site.eventTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
    </label>
    <label>
      <span>Event date <em aria-hidden="true">*</em></span>
      <input name="eventDate" type="date" required />
    </label>
    <label>
      <span>Venue or location <em aria-hidden="true">*</em></span>
      <input name="location" autocomplete="address-level2" required />
    </label>
    <label>
      <span>Guest count <small>(optional)</small></span>
      <input name="guestCount" type="number" min="1" inputmode="numeric" />
    </label>
    <label class="form-message">
      <span>Tell us about the event <em aria-hidden="true">*</em></span>
      <textarea name="message" rows="5" required></textarea>
    </label>
  </div>

  <div class="form-action-row">
    <button class="button button-primary" type={hasBookingEndpoint ? 'submit' : 'button'} data-booking-submit>
      {submitLabel}
    </button>
    <div>
      <p class="form-status" data-booking-status role="status" aria-live="polite">
        {hasBookingEndpoint
          ? 'Your inquiry will be sent to DJ Phelix for review. Sending does not reserve a date or confirm availability, pricing, or services. A brief anti-spam check may appear.'
          : 'No booking endpoint is connected yet. This form will not claim to send your message.'}
      </p>
      {hasInquiryEmail ? (
        <p class="form-fallback">Prefer direct email? <a href={`mailto:${site.contact.inquiryEmail}`}>{site.contact.inquiryEmail}</a></p>
      ) : (
        <p class="form-fallback">An owner-supplied booking email can be added as the direct fallback before launch.</p>
      )}
    </div>
  </div>

  <p class="form-privacy">
    By sending this form, you consent to DJ Phelix using these details to respond to and coordinate your inquiry.
    Do not include Social Security numbers, tax IDs, banking information, passwords, or payment-card details.
    <a href="/privacy/">Read the privacy notice.</a>
  </p>

  {!hasBookingEndpoint && (
    <noscript>
      <p class="noscript-note">This form cannot send without a configured delivery route. Use the direct email option instead.</p>
    </noscript>
  )}
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  const submit = document.querySelector<HTMLButtonElement>('[data-booking-submit]');
  const status = document.querySelector<HTMLElement>('[data-booking-status]');

  const updateStatus = (message: string, isError = false) => {
    if (!status) return;
    status.textContent = message;
    status.dataset.error = String(isError);
  };

  if (form && submit && !form.dataset.bookingEndpoint) {
    submit.addEventListener('click', () => {
      if (!form.checkValidity()) {
        form.reportValidity();
        updateStatus('Please complete the required fields before preparing your inquiry.', true);
        return;
      }

      updateStatus(
        'No inquiry delivery route is connected. Your details have not been sent. Use the direct email option instead.',
        true
      );
    });
  }
</script>

<style>
  .form-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
